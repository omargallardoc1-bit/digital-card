{
  "rewrites": [
    {
      "source": "/platform-admin",
      "destination": "/platform-admin.html"
    },
    {
      "source": "/platform-admin/",
      "destination": "/platform-admin.html"
    },
    {
      "source": "/admin",
      "destination": "/admin-shell.html"
    },
    {
      "source": "/admin/",
      "destination": "/admin-shell.html"
    },
    {
      "source": "/((?!.*\\.).*)",
      "destination": "/index.html"
    }
  ]
}
