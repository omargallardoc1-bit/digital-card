{
  "routes": [
    {
      "src": "^/$",
      "dest": "/admin-shell.html"
    },
    {
      "src": "^/platform-admin/?$",
      "dest": "/platform-admin.html"
    },
    {
      "src": "^/admin/?$",
      "dest": "/admin-shell.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/((?!.*\\.).*)",
      "dest": "/index.html"
    }
  ]
}
